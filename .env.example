# .envで利用する。

DJANGO_SECRET_KEY = genarate a new one for production use, e.g. using `django.core.management.utils.get_random_secret_key()`

DJANGO_ALLOWED_HOSTS=localhost,0.0.0.0,127.0.0.1

# use local docker db settings
DATABASE_ENGINE=postgresql_psycopg2
DATABASE_NAME=dbname
DATABASE_USERNAME=dbuser
DATABASE_PASSWORD=12345678
DATABASE_HOST=db
DATABASE_PORT=5432

# Email settings 
# If not settings use console backend
GMAIL_HOST_USER= 
GMAIL_HOST_PASSWORD= 
# or
RESEND_API_KEY = 

# both settings
NEXT_PUBLIC_URL=http://localhost:3000
# front settings
DJANGO_INTERNAL_URL=http://django-web:8000      # SSR用（サーバー間通信）

